<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="slobsRequestHandler" class="gov.noaa.gsl.edex.atomsSeaLevelObs.handlers.SeaLevelObsRequestHandler" />

    <bean factory-bean="handlerRegistry" factory-method="register">
         <constructor-arg value="gov.noaa.gsl.common.dataplugin.atomsSeaLevelObs.request.SeaLevelObsRequest"/>
         <constructor-arg ref="slobsRequestHandler"/>
    </bean>

</beans>
