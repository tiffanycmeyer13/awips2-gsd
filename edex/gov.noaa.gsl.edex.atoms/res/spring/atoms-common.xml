<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="atomsPluginName" class="java.lang.String">
        <constructor-arg type="java.lang.String" value="atoms" />
    </bean>

    <bean id="atomsProperties" class="com.raytheon.uf.common.dataplugin.PluginProperties">
            <property name="pluginName" ref="atomsPluginName" />
            <property name="pluginFQN" value="gov.noaa.gsl.common.dataplugin.atoms" />
            <!-- property name="dao" value="gov.noaa.gsl.edex.atoms.AtomsPhyEventEdexDao" /-->
            <property name="record" value="gov.noaa.gsl.common.dataplugin.pem.PhysicalEvent" />
            <property name="database" value="metadata" />
            <property name="dependencyFQNs">
                <list>
                   <value>gov.noaa.gsl.common.dataplugin.pem</value>
                </list>
            </property>
     </bean>

    <bean id="atomsRegistered" factory-bean="pluginRegistry" factory-method="register" depends-on="pemRegistered">
        <constructor-arg ref="atomsPluginName"/>
        <constructor-arg ref="atomsProperties"/>
    </bean>

</beans>
