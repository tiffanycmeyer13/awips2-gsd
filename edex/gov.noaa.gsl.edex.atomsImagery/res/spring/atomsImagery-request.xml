<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="descsRequestHandler" class="gov.noaa.gsl.edex.atomsImagery.handlers.TfsImageryDescriptorsRequestHandler" />

    <bean factory-bean="handlerRegistry" factory-method="register">
         <constructor-arg value="gov.noaa.gsl.common.dataplugin.atomsImagery.request.TfsImageryDescriptorsRequest"/>
         <constructor-arg ref="descsRequestHandler"/>
    </bean>

</beans>
