<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">
 
    <bean id="pemPluginName" class="java.lang.String">
        <constructor-arg type="java.lang.String" value="pem" />
    </bean>

    <bean id="pemProperties" class="com.raytheon.uf.common.dataplugin.PluginProperties">
        <property name="pluginName" ref="pemPluginName" />
        <property name="pluginFQN" value="gov.noaa.gsl.common.dataplugin.pem" />
        <property name="record" value="gov.noaa.gsl.common.dataplugin.pem.PhysicalEvent" />
        <property name="dao" value="gov.noaa.gsl.edex.pem.PhysicalEventEdexDao" />
    </bean>

    <bean id="pemRegistered" factory-bean="pluginRegistry" factory-method="register">
        <constructor-arg ref="pemPluginName"/>
        <constructor-arg ref="pemProperties"/>
    </bean>


</beans>