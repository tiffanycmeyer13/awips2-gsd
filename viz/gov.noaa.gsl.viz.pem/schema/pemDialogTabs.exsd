   <element name="pemDialogTab">
      <complexType>
         <attribute name="physicalEventType" type="string" use="required">
            <annotation>
               <documentation>
                  For example, SEISMIC or VOLCANIC or LANDSLIDE. See PhysicalEventType.java.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="orderIndex" type="string">
            <annotation>
               <documentation>
                  Integer index representing the order from left to right of the Tabs, starting at 0. Each extension defined in various viz plugins should coordinate this order, so that viz plugin A may define 3 tabs from 0..2, and viz plugin B may defined 2 tabs from 3..4, etc. If not specified, the tabs may be in a somewhat random order, depending on all of the extensions defined in various viz plugins.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="title" type="string">
            <annotation>
               <documentation>
                  Title for the tab.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="class" type="string" use="required">
            <annotation>
               <documentation>
                  
               </documentation>
               <appInfo>
                  <meta.attribute kind="java" basedOn=":gov.noaa.gsl.viz.pem.dialog.PEMDialogTab"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

